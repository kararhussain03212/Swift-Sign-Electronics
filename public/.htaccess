Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and canonical host (sstechnologies.pk, no www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://sstechnologies.pk%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Don't rewrite index.html
  RewriteRule ^index\.html$ - [L]

  # Don't rewrite existing files (e.g. product images)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Don't rewrite if it looks like a file (has an extension) but doesn't exist -> let it 404
  RewriteCond %{REQUEST_URI} \.
  RewriteRule ^ - [L]

  # Rewrite everything else to index.html for React Router
  RewriteRule ^ /index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content"

  # Don't cache HTML (so deploys/updates are picked up immediately)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "private, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache hashed static assets aggressively
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|avif|gif|ico|svg|woff|woff2|ttf|eot|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Disable access to sensitive files
<FilesMatch "(^\.env|\.git|\.htpasswd|composer\.lock|package-lock\.json|package\.json|vite\.config\.js)$">
  Deny from all
</FilesMatch>
